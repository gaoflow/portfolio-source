---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { topics, type Topic } from '../../data/topics';

export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const projects = (await getCollection('projects'))
  .filter((project) => project.data.categories.includes(topic.slug))
  .sort((a, b) => b.data.updated.localeCompare(a.data.updated) || a.data.order - b.data.order);
---

<Base title={topic.title} description={topic.description}>
  <article class="mx-auto max-w-5xl px-6 pt-12 pb-24">
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted">
      <a href="/" class="hover:text-accent">Home</a>
      <span aria-hidden="true"> / </span>
      <span>Topics</span>
    </nav>

    <header class="mt-6 max-w-3xl">
      <h1 class="text-4xl font-medium tracking-tight text-ink sm:text-5xl">{topic.title}</h1>
      <p class="mt-5 text-xl leading-relaxed text-warm">{topic.description}</p>
    </header>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {projects.map((project) => (
        <a href={`/projects/${project.id}/`} class="project-card group">
          {project.data.heroImage ? (
            <img
              src={project.data.heroImage}
              alt={project.data.title}
              loading="lazy"
              decoding="async"
              class:list={[
                'project-card-media',
                project.data.cardImageFit === 'cover' && 'project-card-media--cover',
              ]}
            />
          ) : (
            <span class="project-card-media project-card-placeholder"></span>
          )}
          <span class="block p-5">
            <span class="block text-lg font-medium leading-snug text-ink transition-colors group-hover:text-accent">
              {project.data.title}
            </span>
            <span class="mt-2 line-clamp-3 block text-sm leading-relaxed text-muted">
              {project.data.summary}
            </span>
          </span>
        </a>
      ))}
    </div>
  </article>
</Base>
