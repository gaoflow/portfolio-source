---
// Web-native CV, print-optimized. Printed to public/cv.pdf after each content change
// (see note in README). Data: src/data/profile.ts + CV export.
import { profile } from '../data/profile';

const skills = [
  { group: 'Engineering & Simulation', items: 'Ansys (Fluent, Mechanical) · STAR-CCM+ · CATIA · SolidWorks · MATLAB & Simulink' },
  { group: 'Programming', items: 'Python · C++ · C · Rust · TypeScript · Java / Kotlin · Ruby on Rails · React' },
  { group: 'Languages', items: 'Chinese (native) · English (full professional) · French (DELF B2)' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>CV — {profile.name}</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: Georgia, 'Times New Roman', serif; color: #181818; max-width: 780px; margin: 0 auto; padding: 48px 32px; font-size: 14px; line-height: 1.5; }
      h1 { font-size: 26px; letter-spacing: 0.02em; }
      .role { font-size: 14px; color: #555; margin-top: 2px; }
      .contact { font-size: 12px; color: #555; margin-top: 8px; font-family: ui-monospace, monospace; }
      h2 { font-size: 12px; text-transform: uppercase; letter-spacing: 0.15em; color: #555; border-bottom: 1px solid #ccc; padding-bottom: 4px; margin: 28px 0 12px; }
      .entry { display: grid; grid-template-columns: 1fr auto; margin-bottom: 10px; }
      .entry .org { font-weight: bold; }
      .entry .title { font-style: italic; }
      .entry .period { color: #555; font-size: 12px; font-family: ui-monospace, monospace; }
      .skills p { margin-bottom: 6px; }
      .skills strong { display: inline-block; width: 200px; }
      @media print { body { padding: 0; } }
    </style>
  </head>
  <body>
    <header>
      <h1>{profile.name}</h1>
      <p class="role">{profile.role} — {profile.tagline}</p>
      <p class="contact">
        {profile.email} · {profile.location}<br />
        {profile.linkedin.replace('https://www.', '')} · {profile.github.replace('https://', '')}
      </p>
    </header>

    <h2>Experience</h2>
    {profile.timeline.filter((t) => t.kind === 'work').map((t) => (
      <div class="entry">
        <div><span class="org">{t.org}</span> — <span class="title">{t.title}</span></div>
        <span class="period">{t.period}</span>
      </div>
    ))}

    <h2>Education</h2>
    {profile.timeline.filter((t) => t.kind === 'education').map((t) => (
      <div class="entry">
        <div><span class="org">{t.org}</span> — <span class="title">{t.title}</span></div>
        <span class="period">{t.period}</span>
      </div>
    ))}

    <h2>Skills</h2>
    <div class="skills">
      {skills.map((s) => <p><strong>{s.group}</strong>{s.items}</p>)}
    </div>
  </body>
</html>
