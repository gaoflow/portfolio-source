---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';

const summary = 'Engineer with nearly 7 years in mobile software development and technical leadership, now applying 2M+ user product delivery experience to CFD, FEM, thermal modelling, and numerical verification while completing a Diplôme d’Ingénieur.';

const facts = [
  { value: '7 years', label: 'Software delivery and technical leadership' },
  { value: '2M+', label: 'Users reached by a product built from scratch' },
  { value: '2027', label: 'Diplôme d’Ingénieur expected' },
];

const experience = [
  {
    role: 'Aerodynamics Engineer',
    organization: 'Vinci Eco Drive, ESILV Formula Student',
    href: 'https://vinciecodrive.fr/',
    place: 'Paris La Défense, France',
    period: 'Sep 2025 — Present',
    bullets: [
      'Led thermal-system modelling for the battery, inverter, and motor, coupling hydraulic, radiator, and transient coolant models to screen the E3 cooling architecture before procurement.',
      'Developed cooling-duct concepts within the aerodynamic package and used an OpenFOAM fan/core surrogate to qualify the numerical method before detailed vehicle CFD.',
    ],
  },
  {
    role: '3D Modelling Intern',
    organization: 'Felisiak Ingénierie & Développement',
    place: 'Paris, France',
    period: 'Apr — Aug 2026 · 17 weeks',
    bullets: [
      'Reconstructed the ESA Space Rider from public blueprints for a launch-campaign review application and delivered separate review and animation-ready assets for Unity and Blender.',
      'Built a scripted Blender audit, rollback, and export workflow and prepared the engineering report, defense poster, and browser-ready GLB.',
    ],
  },
  {
    role: 'Mobile Application Development Manager',
    organization: 'Inkeverse Group Ltd',
    href: 'https://ir.inkeverse.com/en/ir_overview.php',
    place: 'Beijing, China',
    period: 'Aug 2016 — Mar 2023',
    bullets: [
      'Led Lao You from inception to 2M+ users; built the product from scratch, wrote 70% of its initial core code, and helped establish it as a revenue source.',
      'Independently developed voiceprint-recognition algorithms and real-time gift-rendering effects for live streaming.',
      'Designed a Ruby-based CI/CD pipeline that automated testing, packaging, and distribution across Android and iOS.',
      'Implemented code and resource obfuscation plus SSL pinning to increase resistance to reverse engineering and traffic interception.',
      'Integrated React Native and built a hotfix mechanism for controlled runtime updates.',
    ],
  },
];

const projects = [
  {
    title: 'Formula Student Cooling System & OpenFOAM Surrogate',
    context: 'Vinci Eco Drive · 2025–2026',
    href: '/projects/fsae-cooling',
    bullets: [
      'Coupled vendor fan, radiator, and pump curves with an 80-cell one-dimensional finite-volume coolant model; the hydraulic operating point reached 10.03 L/min.',
      'Identified that the passive E3 architecture violated the inverter temperature boundary before procurement and detailed vehicle CFD, documenting a NO-GO decision and replacement architecture paths.',
      'Qualified a fan-jump and porous-core OpenFOAM surrogate on four meshes from 7,440 to 3,481,920 cells; fine-to-extra-fine changes were 0.950% in flow and 0.0145% in pressure loss.',
      'Scope: numerical screening and surrogate-method qualification, not installed-vehicle airflow, heat transfer, hardware, or track validation.',
    ],
  },
  {
    title: 'F1 External-Aerodynamics RANS Pilot',
    context: 'Independent study · 2026',
    href: '/projects/f1-2026-aero',
    bullets: [
      'Built a 4.35M-cell OpenFOAM 14 half-car RANS baseline and completed a 23-variant pilot campaign across geometry, boundary-condition, and modelling sensitivities.',
      'Automated CAD variant staging, snappyHexMesh, steady RANS, validity gates, component-force extraction, and result archiving; retained nine valid sensitivity cases and preserved two diverged roughness runs.',
      'Kept material mesh sensitivity visible and excluded absolute aerodynamic-performance, yaw, wind-tunnel, and physical-correlation claims.',
    ],
  },
  {
    title: 'FlowLab & FlowROM',
    context: 'Independent study · 2026',
    href: '/projects/flowlab',
    bullets: [
      'Implemented a dependency-free D2Q9 BGK lattice-Boltzmann solver shared by Node.js and the browser; validated three grids at Re=100 against canonical lid-driven-cavity data.',
      'Generated 480 velocity fields, using 320 snapshots for training and 160 snapshots across four complete holdout cycles for POD/DMD evaluation.',
      'Achieved 0.123% rank-8 POD holdout error with 48.8× compression and 0.100% DMD full-state holdout error; scope remains controlled two-dimensional internal flow.',
    ],
  },
  {
    title: 'Space Rider Digital Model',
    context: 'Felisiak Ingénierie & Développement · 2026',
    href: '/projects/space-rider',
    bullets: [
      'Reconstructed the ESA Space Rider from public blueprints during a 17-week internship; the internal verification record reports ±6 mm side-view and ±8.4 mm top-view agreement over a 4.88 m body.',
      'Used scripted geometry audits, protected baselines, rollback branches, and reference-view checks to retain failed approaches and prevent local surface fixes from changing accepted proportions.',
      'Delivered separate review and animation-ready assets and reduced the browser GLB from 11.6 MB to 639 KB while preserving the declared release structure.',
      'Scope: reference-led work for Felisiak using public ESA material, not ESA employment, manufacturer CAD, or flight-article validation.',
    ],
  },
  {
    title: 'XC48 Abaqus Tensile Twin',
    context: 'Course project · 2026',
    href: '/projects/xc48-abaqus-twin',
    bullets: [
      'Built a Python pipeline from raw force/displacement data to validated material inputs, Abaqus ODB post-processing, and report generation for an XC48 tensile study.',
      'Matched the retained experiment with R²=0.9663 on the M2 mesh and verified a 5% pre-fracture kinetic/internal energy bound; scope excludes sole authorship of the full team Abaqus model.',
    ],
  },
  {
    title: 'Airfoil & Ground-Effect Methods',
    context: 'Independent studies · 2026',
    href: '/projects/airfoil-methods',
    bullets: [
      'Implemented a cosine-spaced Hess–Smith panel method for NACA 0012 and compared linear lift against NASA TM-4074; the 160-to-240-panel lift change at 4° was 0.0307%.',
      'Built a horseshoe/image-vortex ground-effect solver over 14 h/c cases; recovered free-air lift within 0.0034% at h/c=50 and changed 0.258% from 64 to 96 span panels.',
      'Scope: linear, inviscid, steady methods, without viscous drag, separation, stall, tyres, bodywork, or race-car performance claims.',
    ],
  },
];

const education = [
  {
    degree: 'Diplôme d’Ingénieur, Modelling & Computational Mechanics',
    institution: 'ESILV',
    place: 'Paris La Défense, France',
    period: 'Sep 2025 — 2027 expected',
    details: [
      'Computational Fluid Dynamics and finite-volume methods, Finite Element Method, Vehicle Dynamics and Powertrains, Sustainable Automotive Engineering, Structural Optimization, Machine Learning, and Digital Twins.',
    ],
  },
  {
    degree: 'Full-time French Studies',
    institution: 'Alliance Française de Beijing',
    place: 'Beijing, China',
    period: 'Apr 2023 — May 2024',
    details: [],
  },
  {
    degree: 'Bachelor of Computer Science',
    institution: 'Changchun University of Science and Technology',
    place: 'Changchun, China',
    period: 'Sep 2012 — Jul 2016 · GPA 3.33/4.00',
    details: [
      'Patent: “Mouse with gamepad function” (CN203870574U, issued Oct 8, 2014).',
      'First Provincial Prize, China Undergraduate Mathematical Contest in Modeling (2014).',
      'First Prize, 8th CUST ACM Programming Competition (2013).',
      'National Scholarship, Ministry of Education award, top 0.2% nationwide (2014–2015).',
      'First Class Scholarship, awarded five times for academic excellence (2012–2015).',
    ],
  },
];

const skills = [
  {
    label: 'Simulation & numerical methods',
    value: 'OpenFOAM, Ansys Fluent, Ansys Mechanical, Star-CCM+, Abaqus, CFD (FVM/RANS), FEM, Lattice Boltzmann Method, POD/DMD, thermal-fluid modelling, mesh studies, and convergence studies.',
  },
  { label: 'CAD & 3D', value: 'CATIA, SolidWorks, and Blender.' },
  {
    label: 'Programming',
    value: 'Java/Kotlin, Python, Ruby/Ruby on Rails, C++, C, Rust, TypeScript/React, Node.js, and MATLAB/Simulink.',
  },
  { label: 'Languages', value: 'French (DELF B2), English (C1), and Chinese (native).' },
];
---

<Base title="Curriculum Vitae" description={summary}>
  <article class="cv-document">
    <header class="cv-hero">
      <div class="cv-eyebrow">
        <p>Curriculum Vitae <span aria-hidden="true">·</span> 2026</p>
        <div class="cv-actions print-hidden">
          <a class="cv-action cv-action-primary" href={profile.cvUrl}>Download PDF</a>
          <button class="cv-action cv-action-ghost" type="button" data-print-cv>Print</button>
        </div>
      </div>

      <h1>Bing Gao</h1>
      <p class="cv-role">Computational Mechanics Engineering Student <span aria-hidden="true">/</span> CFD, Thermal Systems & Engineering Software</p>

      <nav class="cv-contact" aria-label="Contact information">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href="tel:+33630659765">+33 6 30 65 97 65</a>
        <span>{profile.location}</span>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>

      <p class="cv-summary">{summary}</p>

      <dl class="cv-facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.value}</dt>
            <dd>{fact.label}</dd>
          </div>
        ))}
      </dl>
    </header>

    <section class="cv-section" id="experience">
      <header class="cv-section-heading">
        <span class="cv-section-number">01</span>
        <div>
          <h2>Experience</h2>
          <p>Engineering and product delivery</p>
        </div>
      </header>
      <div class="cv-section-body">
        {experience.map((item) => (
          <article class="cv-entry">
            <header class="cv-entry-heading">
              <div>
                <h3>{item.role}</h3>
                <p class="cv-organization">
                  {item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.organization}</a> : item.organization}
                  <span aria-hidden="true"> · </span>{item.place}
                </p>
              </div>
              <p class="cv-period">{item.period}</p>
            </header>
            <ul>
              {item.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="cv-section" id="projects">
      <header class="cv-section-heading">
        <span class="cv-section-number">02</span>
        <div>
          <h2>Selected work</h2>
          <p>Methods, evidence, and boundaries</p>
        </div>
      </header>
      <div class="cv-section-body">
        {projects.map((project) => (
          <article class="cv-entry cv-project">
            <header class="cv-entry-heading">
              <div>
                <h3><a href={project.href}>{project.title}</a></h3>
                <p class="cv-organization">{project.context}</p>
              </div>
              <a class="cv-case-link print-hidden" href={project.href}>Case study <span aria-hidden="true">→</span></a>
            </header>
            <ul>
              {project.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="cv-section" id="education">
      <header class="cv-section-heading">
        <span class="cv-section-number">03</span>
        <div>
          <h2>Education</h2>
          <p>Mechanics, computation, and software</p>
        </div>
      </header>
      <div class="cv-section-body">
        {education.map((item) => (
          <article class="cv-entry cv-education">
            <header class="cv-entry-heading">
              <div>
                <h3>{item.degree}</h3>
                <p class="cv-organization">{item.institution} <span aria-hidden="true"> · </span>{item.place}</p>
              </div>
              <p class="cv-period">{item.period}</p>
            </header>
            {item.details.length > 0 && (
              <ul>
                {item.details.map((detail) => <li>{detail}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="cv-section" id="skills">
      <header class="cv-section-heading">
        <span class="cv-section-number">04</span>
        <div>
          <h2>Core skills</h2>
          <p>Tools and working languages</p>
        </div>
      </header>
      <dl class="cv-section-body cv-skill-list">
        {skills.map((skill) => (
          <div class="cv-skill-row">
            <dt>{skill.label}</dt>
            <dd>{skill.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="cv-section" id="community">
      <header class="cv-section-heading">
        <span class="cv-section-number">05</span>
        <div>
          <h2>Community</h2>
          <p>Developer education at scale</p>
        </div>
      </header>
      <div class="cv-section-body">
        <article class="cv-entry cv-community">
          <header class="cv-entry-heading">
            <div>
              <h3>Core Organizer (part-time)</h3>
              <p class="cv-organization"><a href="https://gdg.community.dev/gdg-beijing/" target="_blank" rel="noopener noreferrer">Google Developer Group Beijing</a> · Beijing, China</p>
            </div>
            <p class="cv-period">Nov 2015 — Mar 2023</p>
          </header>
          <ul>
            <li>Organized free technical events that regularly drew 200+ attendees and featured speakers from Google and Silicon Valley.</li>
            <li>Led technical knowledge sharing across mobile development, open-source tools, and emerging engineering topics.</li>
          </ul>
        </article>
      </div>
    </section>

    <div class="cv-closing">
      <p>Detailed methods, figures, and evidence records are available in the <a href="/projects">engineering portfolio</a>.</p>
      <p class="cv-closing-mark">Bing Gao <span aria-hidden="true">·</span> Paris La Défense</p>
    </div>
  </article>

  <script>
    document.querySelector('[data-print-cv]')?.addEventListener('click', () => window.print());
  </script>
</Base>

<style>
  .cv-document {
    max-width: 64rem;
    margin-inline: auto;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .cv-hero {
    padding: 3rem 0 5rem;
  }

  .cv-eyebrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .cv-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .cv-action {
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    font-family: var(--font-serif);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .cv-action-primary {
    color: var(--color-bg);
    background: var(--color-accent);
  }

  .cv-action-ghost {
    color: var(--color-accent);
    background: transparent;
  }

  @media (hover: hover) {
    .cv-action:hover {
      transform: translateY(-1px);
    }

    .cv-action-primary:hover {
      background: var(--color-accent-light);
    }

    .cv-action-ghost:hover {
      background: var(--color-tint);
    }
  }

  .cv-hero h1 {
    margin: 0;
    font-size: clamp(4.2rem, 9.5vw, 7.8rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.86;
  }

  .cv-role {
    max-width: 50rem;
    margin-top: 2rem;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.35;
    color: var(--color-warm);
    text-wrap: balance;
  }

  .cv-role span {
    color: var(--color-accent);
  }

  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.1rem;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-stone);
  }

  .cv-contact a,
  .cv-entry a,
  .cv-closing a {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (hover: hover) {
    .cv-contact a:hover,
    .cv-entry a:hover,
    .cv-closing a:hover {
      color: var(--color-accent-light);
    }
  }

  .cv-summary {
    max-width: 51rem;
    margin-top: 3.75rem;
    font-size: clamp(1.3rem, 2.3vw, 1.65rem);
    line-height: 1.55;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .cv-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 4rem;
    border-top: 1px solid var(--color-edge);
    border-bottom: 1px solid var(--color-edge);
  }

  .cv-facts > div {
    min-width: 0;
    padding: 1.5rem 1.5rem 1.6rem 0;
  }

  .cv-facts > div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-edge-soft);
  }

  .cv-facts dt {
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    font-weight: 500;
    line-height: 1;
    color: var(--color-ink);
  }

  .cv-facts dd {
    max-width: 13rem;
    margin-top: 0.65rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-stone);
  }

  .cv-section {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding: 4.5rem 0;
    border-top: 1px solid var(--color-edge);
  }

  .cv-section-heading {
    align-self: start;
  }

  .cv-section-number {
    display: block;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .cv-section-heading h2 {
    margin: 0;
    font-size: 1.55rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .cv-section-heading p {
    margin-top: 0.65rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-stone);
  }

  .cv-section-body {
    min-width: 0;
  }

  .cv-entry + .cv-entry {
    margin-top: 2.75rem;
    padding-top: 2.75rem;
    border-top: 1px solid var(--color-edge-soft);
  }

  .cv-entry-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
  }

  .cv-entry h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .cv-organization {
    margin-top: 0.35rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .cv-period,
  .cv-case-link {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.69rem;
    line-height: 1.45;
    white-space: nowrap;
    color: var(--color-stone);
  }

  .cv-case-link {
    color: var(--color-accent);
  }

  .cv-entry ul {
    margin: 1.25rem 0 0;
    padding-left: 1.15rem;
    list-style-type: disc;
  }

  .cv-entry li {
    padding-left: 0.35rem;
    font-size: 0.96rem;
    line-height: 1.62;
    color: var(--color-warm);
  }

  .cv-entry li + li {
    margin-top: 0.55rem;
  }

  .cv-entry li::marker {
    color: var(--color-accent);
  }

  .cv-project h3 a {
    color: var(--color-ink);
  }

  @media (hover: hover) {
    .cv-project h3 a:hover {
      color: var(--color-accent);
    }
  }

  .cv-skill-list {
    margin: 0;
  }

  .cv-skill-row {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-edge-soft);
  }

  .cv-skill-row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .cv-skill-row dt {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .cv-skill-row dd {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-warm);
  }

  .cv-closing {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem 0 1rem;
    border-top: 1px solid var(--color-edge);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .cv-closing-mark {
    flex: none;
    font-style: italic;
  }

  @media (max-width: 760px) {
    .cv-hero {
      padding: 1.5rem 0 3.5rem;
    }

    .cv-eyebrow {
      align-items: flex-start;
      margin-bottom: 3rem;
    }

    .cv-section {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3.5rem 0;
    }

    .cv-section-heading {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0.75rem;
    }

    .cv-section-number {
      margin: 0.25rem 0 0;
    }

    .cv-skill-row {
      grid-template-columns: 10rem minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .cv-eyebrow {
      display: block;
    }

    .cv-actions {
      margin-top: 1.25rem;
    }

    .cv-action {
      min-width: 0;
    }

    .cv-hero h1 {
      font-size: clamp(3.35rem, 20vw, 4.6rem);
    }

    .cv-role {
      margin-top: 1.5rem;
      font-size: 1.15rem;
    }

    .cv-contact {
      display: grid;
      gap: 0.5rem;
    }

    .cv-summary {
      margin-top: 2.75rem;
      font-size: 1.18rem;
    }

    .cv-facts {
      grid-template-columns: 1fr;
      margin-top: 3rem;
    }

    .cv-facts > div,
    .cv-facts > div + div {
      padding: 1.1rem 0;
      border-left: 0;
    }

    .cv-facts > div + div {
      border-top: 1px solid var(--color-edge-soft);
    }

    .cv-facts dd {
      max-width: none;
    }

    .cv-entry-heading {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .cv-period,
    .cv-case-link {
      white-space: normal;
    }

    .cv-entry + .cv-entry {
      margin-top: 2.25rem;
      padding-top: 2.25rem;
    }

    .cv-skill-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1.1rem 0;
    }

    .cv-closing {
      display: block;
    }

    .cv-closing-mark {
      margin-top: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-action {
      transition: none;
    }
  }

  @media print {
    @page {
      size: A4;
      margin: 12mm 14mm;
    }

    :global(body) {
