---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The requested portfolio page does not exist." noindex>
  <section class="mx-auto max-w-2xl px-6 pt-24 pb-32">
    <p class="font-mono text-xs tracking-[0.2em] uppercase text-accent">404</p>
    <h1 class="mt-4 text-4xl font-medium tracking-tight">Page not found</h1>
    <p class="mt-5 leading-relaxed text-muted">The page was removed or the address is wrong.</p>
    <a href="/projects" class="mt-8 inline-block font-mono text-xs text-accent hover:underline">Browse verified projects →</a>
  </section>
</Base>
