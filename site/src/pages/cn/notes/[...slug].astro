---
import NoteDetail from '../../../components/NoteDetail.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const [notes, notesCn] = await Promise.all([
    getCollection('notes'),
    getCollection('notesCn'),
  ]);
  const englishIds = new Set(notes.map((note) => note.id));
  const orphaned = notesCn.filter((note) => !englishIds.has(note.id));

  if (orphaned.length > 0) {
    throw new Error(`Chinese notes without English counterparts: ${orphaned.map((note) => note.id).join(', ')}`);
  }

  return notesCn.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
---

<NoteDetail note={note} locale="cn" hasAlternate={true} />
