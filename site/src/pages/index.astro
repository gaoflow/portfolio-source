---
import Base from '../layouts/Base.astro';
import CasePipeline from '../components/CasePipeline.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date) || (b.data.studySequence ?? 0) - (a.data.studySequence ?? 0) || a.data.order - b.data.order,
);
const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf() || a.data.order - b.data.order,
);
const fmt = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Base title="Home">
  {/* 1. Hero — one pitch line + capability strip */}
  <section class="max-w-3xl">
    <h1 class="text-4xl font-medium leading-[1.1] tracking-tight text-ink sm:text-5xl">
      External-aerodynamics CFD{' '}
      <span class="text-muted">with auditable numbers.</span>
    </h1>
    <p class="mt-6 text-xl leading-relaxed text-muted">
      {profile.pitch}
    </p>
    <dl class="mt-10 space-y-3 border-l border-edge pl-4">
      {profile.capabilities.map((c) => (
        <div>
          <dt class="font-serif text-xs font-medium uppercase tracking-[0.1em] text-stone">{c.label}</dt>
          <dd class="text-base text-ink/85">{c.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* 2. Representative case — one honest verification chain */}
  <section class="mt-16 max-w-4xl">
    <CasePipeline steps={profile.caseSteps} />
  </section>

  {/* 3. Projects — the full catalogue, oldest first */}
  <section class="mt-20">
    <div class="mb-5 flex items-baseline justify-between">
      <h2 class="section-label"><span class="section-num mr-2">01</span>Projects</h2>
      <span class="font-serif text-xs text-stone tabular-nums">{projects.length}</span>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      {projects.map((p, i) => (
        <a
          href={`/projects/${p.id}`}
          class="group border border-edge bg-surface transition-shadow hover:shadow-[0_4px_24px_rgba(0,0,0,0.05)]"
        >
          {p.data.heroImage ? (
            <img
              src={p.data.heroImage}
              alt={p.data.title}
              loading="lazy"
              decoding="async"
              class="aspect-[2/1] w-full border-b border-edge bg-white object-cover"
            />
          ) : (
            <span class="flex aspect-[2/1] w-full items-center justify-center border-b border-edge bg-tint">
              <span class="tag">{p.data.tags[0]}</span>
            </span>
          )}
          <span class="block p-5">
            <span class="flex items-baseline justify-between gap-3">
              <span class="section-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-serif text-xs text-stone tabular-nums">{fmt(p.data.date)}</span>
            </span>
            <span class="mt-2 block font-medium text-lg leading-snug text-ink transition-colors group-hover:text-accent">{p.data.title}</span>
            <span class="mt-2 line-clamp-3 block text-sm leading-relaxed text-muted">{p.data.summary}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  {/* 4. Engineering notes — writing feed */}
  {notes.length > 0 && (
    <section class="mt-20">
      <div class="mb-5 flex items-baseline justify-between">
        <h2 class="section-label"><span class="section-num mr-2">02</span>Engineering notes</h2>
        <a href="/notes/" class="font-serif text-xs text-stone transition-colors hover:text-accent transition-colors hover:text-accent">All notes →</a>
      </div>
      <div class="border border-edge bg-surface">
        {notes.map((n) => (
          <a
            href={`/notes/${n.id}`}
            class="group grid grid-cols-[1fr] items-center gap-4 border-b border-edge-soft px-4 py-4 transition-shadow last:border-b-0 hover:shadow-[0_4px_24px_rgba(0,0,0,0.05)] sm:grid-cols-[144px_1fr_auto]"
          >
            <img
              src={n.data.image}
              alt={n.data.title}
              loading="lazy"
              decoding="async"
              class="hidden aspect-video w-full border border-edge bg-surface object-cover sm:block"
            />
            <span class="min-w-0">
              <span class="block font-medium text-lg leading-snug text-ink transition-colors group-hover:text-accent">{n.data.title}</span>
              <span class="mt-1 line-clamp-2 block text-base leading-relaxed text-muted">{n.data.summary}</span>
            </span>
            <span class="hidden font-serif text-xs text-stone whitespace-nowrap tabular-nums sm:block">
              {n.data.published.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
