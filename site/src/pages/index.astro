---
import Base from '../layouts/Base.astro';
import CasePipeline from '../components/CasePipeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const all = await getCollection('projects');
const featured = all.filter((p) => p.data.featured).sort(
  (a, b) => (a.data.studySequence ?? 999) - (b.data.studySequence ?? 999) || a.data.date.localeCompare(b.data.date) || a.data.order - b.data.order,
);
const featuredNotes = (await getCollection('notes'))
  .filter((note) => note.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Representative evidence from the ESILV Fluent verification series.
const caseSteps = [
  { label: 'Analytical check', caption: 'A Re=100 pipe case established signs, mass conservation and Hagen–Poiseuille scale before the cylinder study.', metrics: [
    { label: 'Vmax error', value: '1.0%' }, { label: 'Mass imbalance', value: '2.8×10⁻¹⁰ kg/s' },
  ]},
  { label: 'Mesh sweep', caption: 'The cylinder mesh grew from 50 to 40,000 cells. The drag coefficient changed by less than 0.1% beyond the selected grid.', metrics: [
    { label: 'Cells tested', value: '50 → 40,000' }, { label: 'Cd plateau', value: '<0.1%' },
  ]},
  { label: 'Domain sweep', caption: 'Far-field distance was swept rather than inherited from the tutorial. Drag changed by less than 1% for D2 ≥ 100 m.', metrics: [
    { label: 'D2 tested', value: '20 → 200 m' }, { label: 'Selected D2', value: '100 m' },
  ]},
  { label: 'Validation', caption: 'The final Reynolds sweep kept failed comparisons visible. Only Re=20 met the coursework 5% error gate.', metrics: [
    { label: 'Cd at Re=10', value: '2.7973' }, { label: 'Error at Re=20', value: '3.83%' },
  ]},
];
---

<Base>
  <!-- Intro (right column opens with the pitch, identity lives in the rail) -->
  <section class="reveal">
    <h2 class="section-label">Intro</h2>
    <p class="mt-5 text-xl leading-relaxed text-ink/90 max-w-2xl">
      I build CFD setups that engineers can trust — from geometry cleanup to validated results.
      Nine years of software engineering leadership, now aimed at external aerodynamics and
      simulation tooling.
    </p>
    <dl class="mt-8 grid sm:grid-cols-2 gap-x-10 gap-y-3 font-mono text-[13px]">
      {profile.capabilities.map((c) => (
        <div class="flex gap-4">
          <dt class="text-muted w-24 shrink-0 uppercase text-[10px] tracking-widest pt-0.5">{c.label}</dt>
          <dd class="text-ink/90">{c.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Representative case -->
  <section class="mt-16 reveal">
    <CasePipeline steps={caseSteps} />
    <a href="/projects/fluent-cyl-vnv" class="mt-4 inline-block font-mono text-xs text-muted hover:text-accent">
      Read the full verification case →
    </a>
  </section>

  <!-- Featured work -->
  <section class="mt-20">
    <div class="flex items-baseline justify-between mb-8">
      <h2 class="section-label">Featured work</h2>
      <a href="/projects" class="font-mono text-xs text-muted hover:text-accent">Every project →</a>
    </div>
    <div class="grid sm:grid-cols-2 gap-6">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="mt-20">
    <div class="flex items-baseline justify-between mb-8">
      <h2 class="section-label">Engineering notes</h2>
      <a href="/notes" class="font-mono text-xs text-muted hover:text-accent">Every note →</a>
    </div>
    <div class="divide-y divide-edge border-y border-edge">
      {featuredNotes.map((note) => (
        <a href={`/notes/${note.id}`} class="group grid gap-2 py-5 sm:grid-cols-[1fr_auto] sm:items-baseline">
          <div>
            <h3 class="text-lg font-medium group-hover:text-accent">{note.data.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{note.data.summary}</p>
          </div>
          <time class="font-mono text-[10px] tracking-wider text-muted" datetime={note.data.published.toISOString()}>
            {note.data.published.toISOString().slice(0, 10)}
          </time>
        </a>
      ))}
    </div>
  </section>
</Base>
