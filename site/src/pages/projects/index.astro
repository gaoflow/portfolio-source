---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { topics } from '../../data/topics';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.updated.localeCompare(a.data.updated)
    || (b.data.studySequence ?? 0) - (a.data.studySequence ?? 0)
    || a.data.order - b.data.order,
);
const featuredProjects = projects.filter((project) => project.data.featured);
const otherProjects = projects.filter((project) => !project.data.featured);
---

<Base
  title="Engineering Projects"
  description="Bing Gao's engineering case studies in external aerodynamics, CFD methodology, thermal-fluid modelling, numerical validation, CAD, and simulation tooling."
>
  <article class="mx-auto max-w-7xl px-6 pt-12 pb-24">
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted">
      <a href="/" class="hover:text-accent">Home</a>
      <span aria-hidden="true"> / </span>
      <span>Projects</span>
    </nav>

    <header class="mt-6 max-w-3xl">
      <p class="section-label">Engineering case studies</p>
      <h1 class="mt-2 text-4xl font-medium tracking-tight text-ink sm:text-5xl">Projects</h1>
      <p class="mt-5 text-xl leading-relaxed text-warm">
        Evidence-led studies across external aerodynamics, thermal-fluid systems, numerical validation, CAD, and engineering software.
      </p>
      <nav class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted" aria-label="Project topics">
        {topics.map((topic) => (
          <a href={`/topics/${topic.slug}/`} class="hover:text-accent">{topic.title}</a>
        ))}
      </nav>
    </header>

    {featuredProjects.length > 0 && (
      <section class="mt-14" aria-labelledby="selected-projects-heading">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="selected-projects-heading" class="text-3xl font-medium tracking-tight text-ink">Selected engineering work</h2>
          <span class="font-mono text-xs text-stone">{featuredProjects.length} case studies</span>
        </div>
        <div class="mt-7 grid gap-5 sm:grid-cols-2">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )}

    <section class="mt-16" aria-labelledby="all-projects-heading">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="all-projects-heading" class="text-3xl font-medium tracking-tight text-ink">All projects</h2>
        <span class="font-mono text-xs text-stone">{projects.length} total</span>
      </div>
      <div class="mt-7 grid gap-5 sm:grid-cols-2">
        {(featuredProjects.length > 0 ? otherProjects : projects).map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </article>
</Base>
