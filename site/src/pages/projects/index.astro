---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date) || (b.data.studySequence ?? 0) - (a.data.studySequence ?? 0) || a.data.order - b.data.order,
);

const filters = [
  { key: 'all', label: 'All' },
  { key: 'course-project', label: 'Course projects' },
  { key: 'full-car', label: 'Full-car CFD' },
  { key: 'fsae', label: 'FSAE' },
  { key: 'component-cfd', label: 'Component CFD' },
  { key: 'tooling', label: 'Tools & automation' },
  { key: 'validation', label: 'Validation' },
  { key: 'design', label: 'Design & CAD' },
];

---

<Base title="Projects">
  <section class="pt-4 pb-20">
    <h1 class="section-label mb-2">Projects · full catalogue</h1>
    <p class="mb-10 max-w-2xl text-muted">Newest first — from the current F1 campaign back to my first-semester toolkit, September 2025.</p>
    <div class="mb-8 flex flex-wrap gap-2" data-filters>
      {filters.map((f, i) => (
        <button
          data-filter={f.key}
          class="filter-btn font-serif text-xs px-3 py-1.5 border border-edge text-muted transition-colors hover:text-ink data-[on]:border-accent data-[on]:text-accent"
          {...(i === 0 ? { 'data-on': '' } : {})}
        >
          {f.label}
        </button>
      ))}
    </div>

    <div class="grid gap-5 sm:grid-cols-2" data-grid>
      {projects.map((p, i) => (
        <a
          href={`/projects/${p.id}`}
          data-categories={[...p.data.categories, ...(p.data.academic ? ['course-project'] : [])].join(' ')}
          class="group border border-edge bg-surface transition-shadow hover:shadow-[0_4px_24px_rgba(0,0,0,0.05)]"
        >
          {p.data.heroImage ? (
            <img
              src={p.data.heroImage}
              alt={p.data.title}
              loading="lazy"
              decoding="async"
              class="aspect-[2/1] w-full border-b border-edge bg-white object-cover"
            />
          ) : (
            <span class="flex aspect-[2/1] w-full items-center justify-center border-b border-edge bg-tint">
              <span class="tag">{p.data.tags[0]}</span>
            </span>
          )}
          <span class="block p-5">
            <span class="flex items-baseline justify-between gap-3">
              <span class="section-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-serif text-xs text-stone tabular-nums">
                {new Date(`${p.data.date}T12:00:00`).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
              </span>
            </span>
            <span class="mt-2 block font-medium text-lg leading-snug text-ink transition-colors group-hover:text-accent">{p.data.title}</span>
            <span class="mt-2 line-clamp-3 block text-sm leading-relaxed text-muted">{p.data.summary}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const rows = document.querySelectorAll<HTMLAnchorElement>('[data-grid] > [data-categories]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter!;
        btns.forEach((b) => (b === btn ? b.setAttribute('data-on', '') : b.removeAttribute('data-on')));
        rows.forEach((r) => {
          const show = key === 'all' || (r.dataset.categories ?? '').split(' ').includes(key);
          r.classList.toggle('hidden', !show);
        });
      });
    });
  </script>
</Base>
