---
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const [projects, projectsCn] = await Promise.all([
    getCollection('projects'),
    getCollection('projectsCn'),
  ]);
  const chineseIds = new Set(projectsCn.map((project) => project.id));

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, hasChinese: chineseIds.has(project.id) },
  }));
}

const { project, hasChinese } = Astro.props;
---

<ProjectDetail project={project} locale="en" hasAlternate={hasChinese} />
