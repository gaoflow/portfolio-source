---
import NoteDetail from '../../components/NoteDetail.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const [notes, notesCn] = await Promise.all([
    getCollection('notes'),
    getCollection('notesCn'),
  ]);
  const chineseIds = new Set(notesCn.map((note) => note.id));

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, hasChinese: chineseIds.has(note.id) },
  }));
}

const { note, hasChinese } = Astro.props;
---

<NoteDetail note={note} locale="en" hasAlternate={hasChinese} />
