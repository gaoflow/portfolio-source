---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { profile } from '../../data/profile';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime() || a.data.order - b.data.order,
);
---

<Base title="Engineering Notes" description="Technical notes on CFD verification, aerodynamic modelling, simulation decisions, and reproducible engineering evidence.">
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-20">
    <h1 class="section-label mb-2">Engineering Notes</h1>
    <p class="max-w-2xl text-muted mb-10">
      Focused explanations of the numerical decisions behind the project work. These are not extra project claims: each note identifies the evidence it uses and the boundary it does not cross.
    </p>

    <div class="grid gap-5">
      {notes.map((note, index) => (
        <a href={`/notes/${note.id}`} class="group border border-edge bg-surface p-6 transition-shadow hover:shadow-[0_4px_24px_rgba(0,0,0,0.05)]">
          {note.data.image && (
            <img src={note.data.image} alt={note.data.title} loading="lazy" decoding="async" class="mb-5 aspect-video w-full border border-edge object-cover" />
          )}
          <div class="flex flex-wrap items-center justify-between gap-3 font-serif text-xs text-stone">
            <span><span class="section-num">{String(index + 1).padStart(2, '0')}</span></span>
            <span>{profile.name} · <time datetime={note.data.published.toISOString()}>{note.data.published.toISOString().slice(0, 10)}</time></span>
          </div>
          <h2 class="mt-4 text-2xl font-medium tracking-tight group-hover:text-accent">{note.data.title}</h2>
          <p class="mt-3 max-w-3xl text-lg leading-relaxed text-muted">{note.data.summary}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {note.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
