---
import 'katex/dist/katex.min.css';
import '../styles/global.css'; /* after KaTeX: our @font-face overrides win */
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/500.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  locale?: 'en';
  alternates?: { hreflang: string; path: string }[];
  pageType?: 'website' | 'profile' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  noindex?: boolean;
}

const {
  title,
  description = profile.tagline,
  image = '/og-card.png',
  imageAlt,
  locale = 'en',
  alternates,
  pageType = 'website',
  publishedTime,
  modifiedTime,
  keywords = [],
  noindex = false,
} = Astro.props;

if (pageType === 'article' && (!title || !publishedTime || !modifiedTime)) {
  throw new Error('Article pages require title, publishedTime, and modifiedTime');
}

const copyByLocale = {
  en: {
    htmlLang: 'en',
    role: profile.role,
    websiteName: `${profile.name} — Engineering Portfolio`,
    rssTitle: `${profile.name} — Engineering Notes`,
  },
} as const;
const copy = copyByLocale[locale];
const htmlLang = copy.htmlLang;
const siteUrl = Astro.site ?? Astro.url;
const homeUrl = new URL('/', siteUrl).toString();
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const personId = `${homeUrl}#person`;
const websiteId = `${homeUrl}#website`;
const alternateLinks = alternates?.map((alternate) => ({
  hreflang: alternate.hreflang,
  href: new URL(alternate.path, siteUrl).toString(),
})) ?? [{ hreflang: htmlLang, href: canonicalUrl }];
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${copy.role}`;
const socialImage = new URL(image, siteUrl).toString();
const socialImageAlt = imageAlt ?? `${pageTitle} social preview`;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: profile.name,
  jobTitle: copy.role,
  description: profile.tagline,
  url: homeUrl,
  image: new URL(profile.image, siteUrl).toString(),
  sameAs: [profile.github, profile.linkedin],
  affiliation: {
    '@type': 'EducationalOrganization',
    name: profile.affiliation.name,
    url: profile.affiliation.url,
  },
  memberOf: {
    '@type': 'Organization',
    name: profile.memberOf,
  },
  knowsAbout: profile.knowsAbout,
};
const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: copy.websiteName,
  url: homeUrl,
  description: profile.tagline,
  author: { '@id': personId },
};
const page = pageType === 'article'
  ? {
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      headline: title,
      description,
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      image: socialImage,
      datePublished: publishedTime,
      dateModified: modifiedTime,
      keywords,
      author: { '@id': personId },
      isPartOf: { '@id': websiteId },
      inLanguage: htmlLang,
    }
  : pageType === 'profile'
    ? {
        '@type': 'ProfilePage',
        '@id': `${canonicalUrl}#profile`,
        name: pageTitle,
        description,
        url: canonicalUrl,
        mainEntity: { '@id': personId },
        isPartOf: { '@id': websiteId },
        inLanguage: htmlLang,
      }
    : {
        '@type': 'WebPage',
        '@id': `${canonicalUrl}#page`,
        name: pageTitle,
        description,
        url: canonicalUrl,
        isPartOf: { '@id': websiteId },
        inLanguage: htmlLang,
      };
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [person, website, page],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/KaTeX_Main-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/KaTeX_Math-Italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="apple-touch-icon" href="/avatar_memoji_05_nobg.png" />
    <link rel="alternate" type="application/rss+xml" title={copy.rssTitle} href="/rss.xml" />
    <meta property="og:type" content={pageType === 'article' ? 'article' : pageType === 'profile' ? 'profile' : 'website'} />
    <meta property="og:site_name" content={copy.websiteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">
    <div class="sticky top-0 z-40 border-b border-edge bg-bg/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-7xl items-center px-6 text-sm lg:px-8">
        <a href="/" class="font-medium text-ink">{profile.name}</a>
      </div>
    </div>

    <main class="page-enter mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
      <slot />
      <footer class="mt-20 border-t border-edge-soft pt-6 text-center text-xs text-stone">
        Copyright © 2026 Bing Gao. All rights reserved.
      </footer>
    </main>
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"e34f07061f3c4e2d83b80aa8d8574cec"}'
    ></script>
  </body>
</html>
