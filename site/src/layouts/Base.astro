---
import '../styles/global.css';
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/600.css';
import '@fontsource/inter-tight/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = profile.tagline, image = '/og-card.png' } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role}`;
const socialImage = new URL(image, Astro.site ?? Astro.url).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: profile.name,
      jobTitle: profile.role,
      url: Astro.site?.toString(),
      sameAs: [profile.github, profile.linkedin],
    },
    {
      '@type': 'WebSite',
      name: `${profile.name} — Engineering Portfolio`,
      url: Astro.site?.toString(),
      description,
      author: { '@type': 'Person', name: profile.name },
    },
  ],
};

const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/notes', label: 'Notes' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <link rel="alternate" type="application/rss+xml" title="Bing Gao — Engineering Notes" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">
    <div class="mx-auto max-w-6xl px-6 lg:grid lg:grid-cols-[380px_1fr] lg:gap-16 lg:px-12">

      <!-- Left rail: identity + nav + socials (sticky on desktop) -->
      <header class="py-10 lg:sticky lg:top-0 lg:flex lg:h-screen lg:flex-col lg:justify-between lg:py-16">
        <div>
          <a href="/" class="block">
            <h1 class="text-3xl lg:text-4xl font-bold tracking-tight text-ink">{profile.name}</h1>
            <p class="mt-2 text-lg text-ink/90">{profile.role}</p>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">{profile.tagline}.</p>
          </a>

          <div class="mt-5 flex items-center gap-2 font-mono text-[11px] tracking-wider uppercase text-muted">
            <span class="inline-block size-1.5 rounded-full bg-ok"></span>
            {profile.statusLine}
          </div>

          <nav class="mt-10 hidden lg:block">
            <ul class="space-y-3">
              {nav.map((n, i) => (
                <li>
                  <a
                    href={n.href}
                    class:list={[
                      'group flex items-center gap-3 font-mono text-[11px] tracking-[0.2em] uppercase',
                      path === n.href ? 'text-accent' : 'text-muted hover:text-ink',
                    ]}
                  >
                    <span class:list={['h-px transition-all', path === n.href ? 'w-12 bg-accent' : 'w-6 bg-muted group-hover:w-12 group-hover:bg-ink']}></span>
                    {String(i + 1).padStart(2, '0')}. {n.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <!-- Mobile nav -->
          <nav class="mt-6 flex gap-5 font-mono text-[11px] tracking-[0.2em] uppercase lg:hidden">
            {nav.map((n) => (
              <a href={n.href} class:list={path === n.href ? 'text-accent' : 'text-muted'}>{n.label}</a>
            ))}
          </nav>
        </div>

        <div class="mt-8 flex items-center gap-5 lg:mt-0">
          <a href={profile.github} aria-label="GitHub" class="text-muted hover:text-accent transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .3.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          </a>
          <a href={profile.linkedin} aria-label="LinkedIn" class="text-muted hover:text-accent transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.31h4.52V23H.24V8.31zM8.34 8.31h4.33v2h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.93V23h-4.51v-7.18c0-1.71-.03-3.92-2.39-3.92-2.39 0-2.76 1.87-2.76 3.8V23H8.34V8.31z"/></svg>
          </a>
          <a href={`mailto:${profile.email}`} aria-label="Email" class="text-muted hover:text-accent transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 7 9-7"/></svg>
          </a>
          <a href={profile.cvUrl} class="font-mono text-[11px] tracking-[0.2em] uppercase text-muted hover:text-accent transition-colors">CV</a>
        </div>
      </header>

      <!-- Right column: page content -->
      <main class="pb-20 lg:py-16">
        <slot />
        <footer class="mt-20 border-t border-edge pt-6 font-mono text-[11px] text-muted flex justify-between">
          <span>{profile.name} · {profile.role}</span>
          <span>Built with Astro</span>
        </footer>
      </main>
    </div>
  </body>
</html>
