---
import 'katex/dist/katex.min.css';
import '../styles/global.css'; /* after KaTeX: our @font-face overrides win */
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/500.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = profile.tagline, image = '/og-card.png' } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role}`;
const socialImage = new URL(image, Astro.site ?? Astro.url).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: profile.name,
      jobTitle: profile.role,
      url: Astro.site?.toString(),
      sameAs: [profile.github, profile.linkedin],
    },
    {
      '@type': 'WebSite',
      name: `${profile.name} — Engineering Portfolio`,
      url: Astro.site?.toString(),
      description,
      author: { '@type': 'Person', name: profile.name },
    },
  ],
};

const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/notes', label: 'Notes' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" type="image/png" href="/avatar_cats1.png" />
    <link rel="preload" href="/fonts/KaTeX_Main-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/KaTeX_Math-Italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="apple-touch-icon" href="/avatar_cats1.png" />
    <link rel="alternate" type="application/rss+xml" title="Bing Gao — Engineering Notes" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">
    <!-- Pit Wall top status bar -->
    <div class="sticky top-0 z-40 border-b border-edge bg-bg/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-5 px-6 text-sm lg:px-8">
        <a href="/" class="font-medium text-ink">{profile.name}</a>
        <span class="hidden text-muted sm:inline">{profile.role}</span>
        <nav class="ml-auto flex items-center gap-4 sm:gap-5">
          {nav.map((n) => (
            <a href={n.href} class:list={['transition-colors', path === n.href ? 'text-accent' : 'text-stone hover:text-accent']}>
              {n.label}
            </a>
          ))}
          <a href={profile.cvUrl} class="btn btn-secondary">CV</a>
        </nav>
      </div>
    </div>

    <main class="page-enter mx-auto max-w-6xl px-6 py-12 lg:px-8 lg:py-16">
      <slot />
      <footer class="mt-20 flex flex-wrap justify-between gap-3 border-t border-edge-soft pt-6 text-xs text-stone">
        <span class="flex items-center gap-3"><img src="/avatar_cats1.png" alt="" width="32" height="32" class="h-8 w-8 rounded-full border border-edge" loading="lazy" decoding="async" /><span>{profile.name} · {profile.role}</span></span>
        <span>UI design thanks to <a href="https://github.com/tw93/Kami" target="_blank" rel="noopener noreferrer" class="text-warm transition-colors hover:text-accent">Kami</a></span>
      </footer>
    </main>
  </body>
</html>
