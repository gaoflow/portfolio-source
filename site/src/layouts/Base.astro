---
import '../styles/global.css';
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/600.css';
import '@fontsource/inter-tight/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = profile.tagline, image = '/og-card.png' } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role}`;
const socialImage = new URL(image, Astro.site ?? Astro.url).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: profile.name,
      jobTitle: profile.role,
      url: Astro.site?.toString(),
      sameAs: [profile.github, profile.linkedin],
    },
    {
      '@type': 'WebSite',
      name: `${profile.name} — Engineering Portfolio`,
      url: Astro.site?.toString(),
      description,
      author: { '@type': 'Person', name: profile.name },
    },
  ],
};

const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/notes', label: 'Notes' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <link rel="alternate" type="application/rss+xml" title="Bing Gao — Engineering Notes" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">
    <!-- Pit Wall top status bar -->
    <div class="sticky top-0 z-40 border-b border-edge bg-bg/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-5 px-6 font-mono text-[11px] uppercase tracking-[0.14em] lg:px-8">
        <a href="/" class="font-semibold tracking-[0.2em] text-ink">{profile.name}</a>
        <span class="hidden text-muted sm:inline">{profile.role}</span>
        <nav class="ml-auto flex items-center gap-4 sm:gap-5">
          {nav.map((n) => (
            <a href={n.href} class:list={['transition-colors', path === n.href ? 'text-accent' : 'text-muted hover:text-ink']}>
              {n.label}
            </a>
          ))}
          <a href={profile.cvUrl} class="border border-edge px-2.5 py-1 text-muted transition-colors hover:border-accent/50 hover:text-accent">CV</a>
        </nav>
      </div>
    </div>

    <main class="mx-auto max-w-6xl px-6 py-12 lg:px-8 lg:py-16">
      <slot />
      <footer class="mt-20 flex flex-wrap justify-between gap-3 border-t border-edge pt-6 font-mono text-[11px] tracking-wider text-muted">
        <span>{profile.name} · {profile.role}</span>
        <span>Built with Astro</span>
      </footer>
    </main>
  </body>
</html>
