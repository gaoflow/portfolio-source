---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { render, type CollectionEntry } from 'astro:content';

type Locale = 'en' | 'cn';
type NoteEntry = CollectionEntry<'notes'> | CollectionEntry<'notesCn'>;

interface Props {
  note: NoteEntry;
  locale: Locale;
  hasAlternate: boolean;
}

const { note, locale, hasAlternate } = Astro.props;
const isChinese = locale === 'cn';
const d = note.data;
const { Content } = await render(note);
const basePath = isChinese ? '/cn/notes' : '/notes';
const alternatePath = hasAlternate
  ? `${isChinese ? '/notes' : '/cn/notes'}/${note.id}`
  : undefined;
---

<Base title={d.title} description={d.summary} locale={locale} alternatePath={alternatePath}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <header class="mb-10 space-y-5">
      <a href={basePath} class="font-serif text-xs text-stone transition-colors hover:text-accent">
        {isChinese ? '← 返回文章列表' : '← Engineering Notes'}
      </a>
      <p class="section-label">{isChinese ? '个人记录' : 'Project note'}</p>
      <h1 class="text-3xl font-medium leading-tight tracking-tight md:text-5xl">{d.title}</h1>
      <p class="text-lg leading-relaxed text-muted">{d.summary}</p>
      {d.image && <img src={d.image} alt={d.title} class="w-full rounded-xl shadow-sm" />}
      <div class="flex flex-wrap items-center gap-3 border-y border-edge-soft py-4 font-serif text-xs text-stone">
        <span class="text-ink/80">{profile.name}</span>
        <span aria-hidden="true">·</span>
        <time datetime={d.published.toISOString()}>{d.published.toISOString().slice(0, 10)}</time>
        <span aria-hidden="true">·</span>
        {d.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>

    <div class="prose prose-neutral max-w-none
      prose-headings:font-medium prose-headings:tracking-tight
      prose-h2:mt-12 prose-h2:text-2xl
      prose-p:text-muted prose-li:text-muted
      prose-strong:text-ink">
      <Content />
    </div>

  </article>
</Base>
