---
import Base from '../layouts/Base.astro';
import ModelViewer from './ModelViewer.astro';
import { render, type CollectionEntry } from 'astro:content';
import { topicBySlug } from '../data/topics';


interface Props {
  project: CollectionEntry<'projects'>;
  relatedProjects: CollectionEntry<'projects'>[];
}

const { project, relatedProjects } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const basePath = '/projects/';
const projectTopics = d.categories.map((slug) => ({ slug, ...topicBySlug[slug] }));
const formatDate = (value: string) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${value}T00:00:00Z`));
const statusLabel = d.status === 'active' ? 'In progress' : 'Complete';
---

<Base
  title={d.title}
  description={d.summary}
  image={`/og/projects/${project.id}.png`}
  imageAlt={`${d.title} — Bing Gao engineering project`}
  pageType="article"
  publishedTime={d.date}
  modifiedTime={d.updated}
  keywords={[...d.categories, ...d.tags]}
>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <header class="space-y-5 mb-10">
      <a href={basePath} class="font-mono text-xs text-muted hover:text-accent">← Projects</a>
      <h1 class="text-3xl md:text-5xl font-medium leading-tight tracking-tight">{d.title}</h1>
      <p class="text-xl text-warm leading-relaxed">{d.summary}</p>
      <p class="font-mono text-xs leading-relaxed text-stone">
        By <a href="/" class="text-accent hover:underline">Bing Gao</a>
        <span aria-hidden="true"> · </span>{statusLabel}
      </p>
      <nav class="flex flex-wrap gap-2" aria-label="Project topics">
        {projectTopics.map((topic) => (
          <a href={`/topics/${topic.slug}/`} class="tag hover:text-accent">{topic.title}</a>
        ))}
        {d.tags.map((tag) => <span class="tag">{tag}</span>)}
      </nav>
      {d.nda && (
        <div class="flex flex-wrap items-center gap-2">
          <span class="tag">NDA-safe write-up</span>
        </div>
      )}
      <dl class="grid gap-x-6 gap-y-4 border-y border-edge-soft py-5 text-sm sm:grid-cols-2">
        {d.role && (
          <div>
            <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-stone">Role</dt>
            <dd class="mt-1 text-warm">{d.role}</dd>
          </div>
        )}
        {d.team && (
          <div>
            <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-stone">Team</dt>
            <dd class="mt-1 text-warm">{d.team}</dd>
          </div>
        )}
        {d.duration && (
          <div>
            <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-stone">Duration</dt>
            <dd class="mt-1 text-warm">{d.duration}</dd>
          </div>
        )}
        {d.academic?.course && (
          <div>
            <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-stone">Course</dt>
            <dd class="mt-1 text-warm">{d.academic.course}</dd>
          </div>
        )}
        <div>
          <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-stone">Published</dt>
          <dd class="mt-1 text-warm"><time datetime={d.date}>{formatDate(d.date)}</time></dd>
        </div>
        <div>
          <dt class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-stone">Updated</dt>
          <dd class="mt-1 text-warm"><time datetime={d.updated}>{formatDate(d.updated)}</time></dd>
        </div>
      </dl>
      {d.github && (
        <p class="text-sm">
          <a href={d.github} target="_blank" rel="noopener noreferrer" class="font-medium text-accent hover:underline">
            Read the source on GitHub →
          </a>
        </p>
      )}
    </header>

    {d.heroVideo && (
      <figure class="mb-10">
        <video
          autoplay
          loop
          muted
          playsinline
          controls
          preload="metadata"
          poster={d.heroVideo.poster}
          aria-label={d.title}
          class="block w-full h-auto rounded-xl shadow-sm"
        >
          <source src={d.heroVideo.src} type="video/mp4" />
          Your browser does not support HTML5 video.
        </video>
        <figcaption class="mt-2 font-mono text-xs leading-relaxed text-stone">{d.heroVideo.caption}</figcaption>
      </figure>
    )}

    {d.academic?.note && (
      <p class="mb-10 border-l-2 border-accent pl-5 text-lg leading-relaxed text-muted">{d.academic.note}</p>
    )}
    {d.academic && d.academic.media.length > 0 && (
      <div class="mb-10 space-y-10">
        {d.academic.media.map((media) => (
          <figure>
            <img src={media.src} alt={media.alt} class="w-full rounded-xl shadow-sm bg-white" loading="lazy" />
            <figcaption class="mt-2 font-mono text-xs leading-relaxed text-stone">{media.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {!d.heroVideo && d.model3d && (
      <ModelViewer
        src={d.model3d}
        alt={d.title}
        poster={d.heroImage}
        caption="Interactive 3D — drag to rotate and scroll to zoom."
      />
    )}
    {!d.heroVideo && d.heroImage && !d.model3d && (
      <img src={d.heroImage} alt={d.title} class="w-full rounded-xl shadow-sm mb-10" loading="lazy" />
    )}

    <div class="prose prose-neutral prose-lg max-w-none
      prose-headings:font-medium prose-headings:tracking-tight
      prose-h2:mt-12 prose-h2:text-3xl
      prose-p:leading-[1.6] prose-li:leading-[1.6]
      prose-strong:text-ink">
      <Content />
    </div>
    {relatedProjects.length > 0 && (
      <aside class="mt-16 border-t border-edge-soft pt-8" aria-labelledby="related-projects-heading">
        <h2 id="related-projects-heading" class="text-2xl font-medium tracking-tight text-ink">Related projects</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          {relatedProjects.map((relatedProject) => (
            <a
              href={`/projects/${relatedProject.id}/`}
              class="rounded-xl border border-edge p-4 transition-colors hover:border-accent"
            >
              <h3 class="font-medium leading-snug text-ink">{relatedProject.data.title}</h3>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{relatedProject.data.summary}</p>
            </a>
          ))}
        </div>
      </aside>
    )}
  </article>
</Base>
