---
import Base from '../layouts/Base.astro';
import ModelViewer from './ModelViewer.astro';
import { render, type CollectionEntry } from 'astro:content';

type Locale = 'en' | 'cn';
type ProjectEntry = CollectionEntry<'projects'> | CollectionEntry<'projectsCn'>;

interface Props {
  project: ProjectEntry;
  locale: Locale;
  hasAlternate: boolean;
}

const { project, locale, hasAlternate } = Astro.props;
const isChinese = locale === 'cn';
const d = project.data;
const { Content } = await render(project);
const basePath = isChinese ? '/cn/projects' : '/projects';
const alternatePath = hasAlternate
  ? `${isChinese ? '/projects' : '/cn/projects'}/${project.id}`
  : undefined;
---

<Base title={d.title} description={d.summary} image={`/og/projects/${project.id}.png`} locale={locale} alternatePath={alternatePath}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <header class="space-y-5 mb-10">
      <a href={basePath} class="font-mono text-xs text-muted hover:text-accent">{isChinese ? '← 返回项目列表' : '← Projects'}</a>
      <h1 class="text-3xl md:text-5xl font-medium leading-tight tracking-tight">{d.title}</h1>
      <p class="text-xl text-warm leading-relaxed">{d.summary}</p>
      <div class="flex flex-wrap items-center gap-2">
        {d.nda && <span class="tag">{isChinese ? '符合 NDA 的公开版本' : 'NDA-safe write-up'}</span>}
        {d.tags.map((tag) => <span class="tag">{tag}</span>)}
        {d.github && (
          <a
            href={d.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-medium rounded border border-accent/30 bg-accent/5 text-accent hover:bg-accent/10 hover:border-accent/60 transition-colors"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>{isChinese ? 'GitHub 源码' : 'GitHub Repository'}</span>
            <span class="opacity-70">↗</span>
          </a>
        )}
      </div>
    </header>

    {d.heroVideo && (
      <figure class="mb-10">
        <video
          autoplay
          loop
          muted
          playsinline
          controls
          preload="metadata"
          poster={d.heroVideo.poster}
          aria-label={d.title}
          class="block w-full h-auto rounded-xl shadow-sm"
        >
          <source src={d.heroVideo.src} type="video/mp4" />
          {isChinese ? '你的浏览器不支持 HTML5 视频。' : 'Your browser does not support HTML5 video.'}
        </video>
        <figcaption class="mt-2 font-mono text-xs leading-relaxed text-stone">{d.heroVideo.caption}</figcaption>
      </figure>
    )}

    {d.academic?.note && (
      <p class="mb-10 border-l-2 border-accent pl-5 text-lg leading-relaxed text-muted">{d.academic.note}</p>
    )}
    {d.academic && d.academic.media.length > 0 && (
      <div class="mb-10 space-y-10">
        {d.academic.media.map((media) => (
          <figure>
            <img src={media.src} alt={media.alt} class="w-full rounded-xl shadow-sm bg-white" loading="lazy" />
            <figcaption class="mt-2 font-mono text-xs leading-relaxed text-stone">{media.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {!d.heroVideo && d.model3d && (
      <ModelViewer
        src={d.model3d}
        alt={d.title}
        poster={d.heroImage}
        caption={isChinese ? '在线预览 3D' : 'Interactive 3D — drag to rotate and scroll to zoom.'}
      />
    )}
    {!d.heroVideo && d.heroImage && !d.model3d && (
      <img src={d.heroImage} alt={d.title} class="w-full rounded-xl shadow-sm mb-10" loading="lazy" />
    )}

    <div class="prose prose-neutral prose-lg max-w-none
      prose-headings:font-medium prose-headings:tracking-tight
      prose-h2:mt-12 prose-h2:text-3xl
      prose-p:leading-[1.6] prose-li:leading-[1.6]
      prose-strong:text-ink">
      <Content />
    </div>
  </article>
</Base>
