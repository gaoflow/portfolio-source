---
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const d = project.data;
---
<a
  href={`/projects/${project.id}`}
  data-categories={d.categories.join(' ')}
  class="group block border border-edge bg-surface hover:border-accent/50 transition-colors"
>
  <!-- Result image (contour/photo) or gradient placeholder until one exists -->
  {d.heroImage ? (
    <img src={d.heroImage} alt={d.title} class="aspect-[16/9] w-full object-cover" loading="lazy" />
  ) : (
    <div class="aspect-[16/9] bg-gradient-to-br from-surface via-edge/40 to-accent/10 flex items-end p-4">
      <span class="font-mono text-[10px] tracking-widest text-muted uppercase">{d.methodLine}</span>
    </div>
  )}
  <div class="p-5 space-y-3">
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="text-lg font-medium leading-snug group-hover:text-accent transition-colors">{d.title}</h3>
      <span class="font-mono text-xs text-muted shrink-0">{d.year}</span>
    </div>
    <p class="text-sm text-muted leading-relaxed">{d.summary}</p>
    <div class="flex flex-wrap gap-2 font-mono text-[10px] tracking-wider uppercase">
      {d.sample && <span class="px-2 py-0.5 border border-accent/60 text-accent">Sample</span>}
      {d.nda && <span class="px-2 py-0.5 border border-edge text-muted">NDA-safe</span>}
      <span class:list={['px-2 py-0.5 border', d.status === 'active' ? 'border-ok/60 text-ok' : 'border-edge text-muted']}>
        {d.status}
      </span>
      {d.tags.map((t) => <span class="px-2 py-0.5 border border-edge text-muted">{t}</span>)}
    </div>
  </div>
</a>
