---
// Interactive 3D model embed (Google model-viewer): auto-loads, drag to rotate, scroll to zoom.
interface Props {
  src: string;
  alt: string;
  poster?: string;
  caption?: string;
}
const { src, alt, poster, caption } = Astro.props;
const viewerId = `model-viewer-${src.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').toLowerCase()}`;
---
<figure class="my-8">
  <div
    class="relative overflow-hidden rounded-xl bg-[#16213a] shadow-sm"
    style="width:100%;height:480px;"
  >
    <model-viewer
      id={viewerId}
      src={src}
      alt={alt}
      poster={poster}
      camera-controls
      auto-rotate
      auto-rotate-delay="1000"
      rotation-per-second="20deg"
      shadow-intensity="0.6"
      exposure="1"
      loading="eager"
      reveal="auto"
      style="width:100%;height:100%;background:#16213a;"
    ></model-viewer>
  </div>
  {caption && <figcaption class="mt-2 text-center text-xs text-muted">{caption}</figcaption>}
</figure>

<script>
  import('@google/model-viewer');

  document.querySelectorAll<HTMLElement>('model-viewer').forEach((viewer) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      viewer.removeAttribute('auto-rotate');
    }
  });
</script>
