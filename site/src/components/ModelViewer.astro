---
// Interactive 3D model embed (Google model-viewer): drag to rotate, scroll to zoom.
interface Props {
  src: string;
  alt: string;
  poster?: string;
  caption?: string;
}
const { src, alt, poster, caption } = Astro.props;
const viewerId = `model-viewer-${src.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').toLowerCase()}`;
---
<figure class="my-8">
  <div
    data-model-viewer-shell
    class="relative overflow-hidden border border-edge rounded bg-[#16213a]"
    style="width:100%;height:480px;"
  >
    {poster ? (
      <img
        data-model-viewer-fallback
        src={poster}
        alt={`${alt} static preview`}
        class="h-full w-full object-cover"
        loading="lazy"
      />
    ) : (
      <div data-model-viewer-fallback class="grid h-full place-items-center font-mono text-xs text-muted">
        Interactive 3D preview
      </div>
    )}
    <model-viewer
      id={viewerId}
      hidden
      src={src}
      alt={alt}
      poster={poster}
      camera-controls
      auto-rotate
      auto-rotate-delay="1500"
      rotation-per-second="20deg"
      shadow-intensity="0.6"
      exposure="1"
      style="width:100%;height:100%;background:#16213a;"
    ></model-viewer>
    <button
      type="button"
      data-model-viewer-load
      aria-controls={viewerId}
      class="absolute bottom-4 left-1/2 min-h-11 -translate-x-1/2 border border-accent bg-bg/90 px-4 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-accent backdrop-blur transition hover:bg-accent hover:text-bg disabled:cursor-wait disabled:opacity-70"
    >
      Load interactive 3D
    </button>
  </div>
  {caption && <figcaption class="mt-2 font-mono text-[11px] text-muted">{caption}</figcaption>}
</figure>

<script>
  let modelViewerModule: Promise<unknown> | undefined;
  const loadModelViewer = () => {
    modelViewerModule ??= import('@google/model-viewer');
    return modelViewerModule;
  };

  document.querySelectorAll<HTMLElement>('[data-model-viewer-shell]').forEach((shell) => {
    const button = shell.querySelector<HTMLButtonElement>('[data-model-viewer-load]');
    const viewer = shell.querySelector<HTMLElement>('model-viewer');
    const fallback = shell.querySelector<HTMLElement>('[data-model-viewer-fallback]');
    if (!button || !viewer || !fallback) return;

    button.addEventListener('click', async () => {
      button.disabled = true;
      button.textContent = 'Loading 3D…';
      await loadModelViewer();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        viewer.removeAttribute('auto-rotate');
      }
      viewer.hidden = false;
      fallback.hidden = true;
      button.remove();
    }, { once: true });
  });
</script>
