{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-www-redirect",
  "main": "workers/www-redirect.ts",
  "compatibility_date": "2026-08-30",
  "routes": [
    {
      "pattern": "www.binggao.dev/*",
      "zone_name": "binggao.dev"
    },
    {
      "pattern": "vinzzy.com/*",
      "zone_name": "vinzzy.com"
    },
    {
      "pattern": "www.vinzzy.com/*",
      "zone_name": "vinzzy.com"
    }
  ]
}
