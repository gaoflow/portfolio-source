{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:seo": "python3 scripts/check_seo.py dist",
    "check:site": "npm run check:seo && python3 scripts/check_static_links.py dist && python3 scripts/check_rendering.py dist && python3 scripts/check_cv_locales.py dist && python3 scripts/check_dark_ui.py dist",
    "verify:seo": "npm run build && npm run check:site",
    "verify:all": "npm run verify:seo && python3 scripts/check_assets.py public/images",
    "submit:indexnow": "python3 scripts/submit_indexnow.py dist/sitemap.xml c68a268aff5d62140ef3185062c68b9d",
    "deploy:production": "bash scripts/deploy_production.sh",
    "deploy:www-redirect": "npx --yes wrangler@4.125.0 deploy --config wrangler.www-redirect.jsonc",
    "preview": "astro preview",
    "serve:dist": "serve dist -l 4321 --no-clipboard",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@fontsource/source-serif-4": "^5.3.0",
    "@google/model-viewer": "^4.3.1",
    "astro": "^7.2.0",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3"
  }
}
